{
  "name": "agentfolio",
  "version": "0.1.0",
  "description": "Safely plan and apply generic agent collections",
  "directories": {
    "doc": "docs",
    "example": "examples",
    "test": "tests"
  },
  "scripts": {
    "test": "node --test tests/**/*.test.mjs",
    "agentfolio": "node ./bin/agentfolio.mjs",
    "check:dependencies": "node scripts/check-dependencies.mjs",
    "check:secrets": "node scripts/secret-scan.mjs",
    "package:smoke": "node --test tests/package-smoke.test.mjs"
  },
  "keywords": [
    "agentfolio",
    "agent-skills",
    "skills-cli"
  ],
  "author": "",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "yaml": "2.9.0",
    "skills": "1.5.23"
  },
  "bin": {
    "agentfolio": "./bin/agentfolio.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "bin",
    "src",
    "docs",
    "examples",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/luabagg/agentfolio.git"
  }
}
